source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version.
# The React Native template says ">= 2.6.10", but the patched activesupport below needs 3.1.
ruby ">= 3.1"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'xcodeproj', '< 1.26.0'

# These two deviate from the React Native template, which pins 'activesupport >= 6.1.7.5' and
# 'concurrent-ruby < 1.3.4' and therefore ships six known CVEs to every project generated from it.
#
# The upstream concurrent-ruby ceiling exists because 1.3.4 dropped its implicit 'logger' require,
# which broke activesupport < 7.1 with an uninitialized-constant error. That is a non-issue here:
# the template already declares 'logger' explicitly further down, and activesupport is now well
# past 7.1 anyway. So the pin only preserves the vulnerability it was never about.
gem 'activesupport', '>= 7.2.3.1'
gem 'concurrent-ruby', '>= 1.3.7'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
